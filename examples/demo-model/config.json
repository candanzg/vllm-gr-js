{
  "model_type": "fuxi",
  "architectures": ["FuXiEmbeddingModel"],

  "torch_dtype": "bfloat16",
  "is_text_encoder": true,
  "is_encoder_decoder": false,
  "is_attention_free": false,

  "max_seq_len": 128,
  "max_num_candidates": 50,
  "max_num_candidates_inference": 50,
  "item_embedding_dim": 64,

  "num_blocks": 2,
  "num_heads": 2,
  "dqk": 64,
  "dv": 64,
  "ffn_multiply": 1.0,
  "ffn_single_stage": false,
  "linear_activation": "silu",
  "linear_dropout_rate": 0.0,
  "attn_dropout_rate": 0.0,
  "layer_norm_eps": 1e-6,

  "enable_relative_attention_bias": false,
  "enable_kv_cache": true,

  "input_preprocessor_type": "posi",
  "positional_embedding_max_len": 128,
  "rating_embedding_dim": 0,
  "num_ratings": 0,
  "output_postprocessor_type": "l2",
  "temperature": 0.05,

  "item_id_feature_name": "item_id",
  "rating_feature_name": "rating",
  "timestamp_feature_name": "timestamp",
  "use_rating_embedding": false,
  "use_timestamp_payload": false,

  "task_names": ["score"]
}
