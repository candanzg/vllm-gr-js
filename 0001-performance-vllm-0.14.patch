+class HeaderPerfTimingMiddleware:
+    """ASGI middleware that records pre-header server timing and emits it via headers."""
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+
+    def __call__(self, scope: Scope, receive: Receive, send: Send) -> Awaitable[None]:
+        if scope["type"] != "http":
+            return self.app(scope, receive, send)
+
+        scope.setdefault("state", {})
+        scope["state"]["vllm_perf_request_entry_perf"] = time.perf_counter()
+
+        async def send_with_perf_headers(message: Message) -> None:
+            if message["type"] == "http.response.start":
+                response_start_perf = time.perf_counter()
+                state = scope.get("state") or {}
+                response_headers = MutableHeaders(raw=message["headers"])
+
+                entry_perf = state.get("vllm_perf_request_entry_perf")
+                route_start_perf = state.get("vllm_perf_chat_route_start_perf")
+                handler_start_perf = state.get("vllm_perf_chat_handler_start_perf")
+                handler_done_perf = state.get("vllm_perf_chat_handler_done_perf")
+                route_return_perf = state.get("vllm_perf_chat_route_return_perf")
+
+                def _append_delta(header_key: str, start_perf, end_perf) -> None:
+                    if start_perf is None or end_perf is None:
+                        return
+                    delta_ms = max(0.0, (float(end_perf) - float(start_perf)) * 1000.0)
+                    response_headers.append(
+                        VLLM_PERF_HEADER_NAMES[header_key],
+                        f"{delta_ms:.3f}",
+                    )
+
+                _append_delta("server_entry_to_route_ms", entry_perf, route_start_perf)
+                _append_delta("server_handler_preprocess_ms", handler_start_perf, handler_done_perf)
+                if route_start_perf is not None and route_return_perf is not None:
+                    handler_ms = (
+                        max(0.0, (float(handler_done_perf) - float(handler_start_perf)) * 1000.0)
+                        if handler_start_perf is not None and handler_done_perf is not None
+                        else 0.0
+                    )
+                    route_total_ms = max(
+                        0.0,
+                        (float(route_return_perf) - float(route_start_perf)) * 1000.0,
+                    )
+                    route_wrapper_ms = max(0.0, route_total_ms - handler_ms)
+                    response_headers.append(
+                        VLLM_PERF_HEADER_NAMES["server_route_wrapper_ms"],
+                        f"{route_wrapper_ms:.3f}",
+                    )
+                _append_delta(
+                    "server_route_return_to_http_start_ms",
+                    route_return_perf,
+                    response_start_perf,
+                )
+                _append_delta("server_entry_to_http_start_ms", entry_perf, response_start_perf)
+                for header_key in (
+                    "server_chat_check_model_ms",
+                    "server_chat_get_adapters_ms",
+                    "server_chat_get_tokenizer_ms",
+                    "server_chat_tool_setup_ms",
+                    "server_chat_validate_template_ms",
+                    "server_chat_preprocess_chat_ms",
+                    "server_chat_build_request_id_ms",
+                    "server_chat_sampling_params_ms",
+                    "server_chat_trace_headers_ms",
+                    "server_chat_generator_setup_ms",
+                ):
+                    value = state.get(header_key)
+                    if value is None:
+                        continue
+                    response_headers.append(
+                        VLLM_PERF_HEADER_NAMES[header_key],
+                        f"{float(value):.3f}",
+                    )
+            await send(message)
+
+        return self.app(scope, receive, send_with_perf_headers)
+
+
 def _extract_content_from_chunk(chunk_data: dict) -> str:
     """Extract content from a streaming response chunk."""
     try:
@@ -943,6 +1052,14 @@ def build_app(args: Namespace) -> FastAPI:
