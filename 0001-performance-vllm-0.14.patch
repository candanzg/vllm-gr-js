+}
+
+
+def function_profile_enabled() -> bool:
+    raw_value = os.getenv("VLLM_GR_FUNCTION_PROFILE", "").strip().lower()
+    return raw_value in {"1", "true", "yes", "on"}
+
+
+def structured_perf_logging_enabled() -> bool:
+    raw_value = os.getenv("VLLM_GR_PERF_LOG", "").strip().lower()
+    return raw_value in {"1", "true", "yes", "on"}
+
+
+def _should_emit_structured_detail(module: str, func: str) -> bool:
+    return structured_perf_logging_enabled() and (
+        module,
+        func,
+    ) in _STRUCTURED_DETAIL_WHITELIST
+
+
+def _emit_structured_perf_event(module: str, func: str, elapsed_s: float) -> None:
+    payload = {
+        "event": "function",
+        "module": module,
+        "func": func,
+        "duration_ms": round(elapsed_s * 1000.0, 3),
+    }
+    _STRUCTURED_LOGGER.info(
+        json.dumps(payload, ensure_ascii=False, sort_keys=True)
+    )
+
+
+def _is_torch_compiling() -> bool:
+    try:
+        import torch._dynamo as dynamo
+
+        return dynamo.is_compiling()
+    except Exception:
+        return False
+
+
+@dataclass
+class _FunctionProfileStats:
+    count: int = 0
+    total_us: float = 0.0
+    max_us: float = 0.0
+    samples_us: list[float] = field(default_factory=list)
+
+    def add(self, elapsed_us: float) -> None:
+        self.count += 1
+        self.total_us += elapsed_us
+        self.max_us = max(self.max_us, elapsed_us)
+        self.samples_us.append(elapsed_us)
+
+
+_PROFILE_LOCK = threading.Lock()
+_PROFILE_DATA: dict[tuple[str, str], _FunctionProfileStats] = defaultdict(_FunctionProfileStats)
+_ATEXIT_REGISTERED = False
+_OUTPUT_DIR_READY = False
+
+
+def _output_dir() -> Path:
+    raw_dir = os.getenv("VLLM_GR_FUNCTION_PROFILE_DIR", "").strip()
+    if raw_dir:
+        return Path(raw_dir).expanduser().resolve()
+    return Path.cwd()
+
+
+def function_profile_output_dir() -> Path:
+    return _output_dir()
+
+
+def _percentile(samples: list[float], percentile: float) -> float:
+    if not samples:
+        return 0.0
+    if len(samples) == 1:
+        return samples[0]
+    ordered = sorted(samples)
+    rank = (len(ordered) - 1) * percentile
+    lower = int(rank)
+    upper = min(lower + 1, len(ordered) - 1)
+    weight = rank - lower
+    return ordered[lower] * (1.0 - weight) + ordered[upper] * weight
+
+
+def _ensure_output_dir() -> Path:
+    global _OUTPUT_DIR_READY
+    out_dir = _output_dir()
+    if not _OUTPUT_DIR_READY:
+        out_dir.mkdir(parents=True, exist_ok=True)
+        _OUTPUT_DIR_READY = True
+    return out_dir
+
+
+def _register_atexit() -> None:
+    global _ATEXIT_REGISTERED
+    if _ATEXIT_REGISTERED:
+        return
+    _ensure_output_dir()
+    atexit.register(write_function_profile_csv)
+    _ATEXIT_REGISTERED = True
+
+
+def record_function_profile(module: str, func: str, elapsed_s: float) -> None:
+    if not function_profile_enabled():
+        return
+    _register_atexit()
+    elapsed_us = elapsed_s * 1_000_000.0
+    with _PROFILE_LOCK:
+        _PROFILE_DATA[(module, func)].add(elapsed_us)
+
+
+def function_profile_start() -> float | None:
+    if not function_profile_enabled():
+        return None
+    return time.perf_counter()
+
+
+def function_profile_end(module: str, func: str, start_time: float | None) -> None:
+    if start_time is None:
+        return
+    record_function_profile(module, func, time.perf_counter() - start_time)
+
+
+def profiled_function(module: str, func: str | None = None) -> Callable[[_F], _F]:
+    def decorator(target: _F) -> _F:
+        func_name = func or target.__name__
+
+        @wraps(target)
+        def wrapped(*args, **kwargs):
+            start_time = function_profile_start()
+            try:
+                return target(*args, **kwargs)
+            finally:
+                function_profile_end(module, func_name, start_time)
+        return wrapped  # type: ignore[return-value]
+
+    return decorator
+
+
+@contextmanager
+def function_profile(module: str, func: str) -> Iterator[None]:
+    if not function_profile_enabled():
+        yield
+        return
+    start = time.perf_counter()
+    try:
+        yield
+    finally:
+        record_function_profile(module, func, time.perf_counter() - start)
+
+
+@contextmanager
+def runtime_function_profile(module: str, func: str) -> Iterator[None]:
+    emit_structured_detail = _should_emit_structured_detail(module, func)
+    if _is_torch_compiling():
+        yield
+        return
+    if not function_profile_enabled() and not emit_structured_detail:
+        yield
+        return
+    start = time.perf_counter()
+    try:
+        yield
+    finally:
+        elapsed_s = time.perf_counter() - start
+        if function_profile_enabled():
+            record_function_profile(module, func, elapsed_s)
+        if emit_structured_detail:
+            _emit_structured_perf_event(module, func, elapsed_s)
+
+
+def write_function_profile_csv() -> None:
+    if not function_profile_enabled():
+        return
+    with _PROFILE_LOCK:
+        items = list(_PROFILE_DATA.items())
+    if not items:
+        return
+
+    out_dir = _ensure_output_dir()
+    pid = os.getpid()
+    output_path = out_dir / f"vllm_function_profile_{pid}.csv"
+    with output_path.open("w", encoding="utf-8", newline="") as f:
+        writer = csv.DictWriter(
+            f,
+            fieldnames=[
+                "module",
+                "func",
+                "count",
+                "total_us",
+                "avg_us",
+                "p99_us",
+                "max_us",
+                "pid",
+            ],
+        )
+        writer.writeheader()
+        for (module, func), stats in sorted(
+            items, key=lambda item: item[1].total_us, reverse=True
+        ):
+            writer.writerow(
+                {
